# --- сервер ---
PLANB_HOST=0.0.0.0
PLANB_PORT=8000
# путь к базе данных (настройки, сделки, журнал)
PLANB_DB=/opt/planb/data/planb.sqlite3

# --- защита панели (рекомендуется) ---
PLANB_AUTH_USER=admin
PLANB_AUTH_PASSWORD=change-me

# --- первый запуск: набор настроек по умолчанию ---
# demo = синтетический рынок + paper-торговля (безопасно, для знакомства)
PLANB_PRESET=demo

# --- API-ключи можно задать настройками в панели, но можно и тут ---
# (значения из этих переменных имеют приоритет только при первом создании настроек)
GATE_API_KEY=
GATE_API_SECRET=
